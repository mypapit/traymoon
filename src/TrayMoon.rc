/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_DIALOG DIALOGEX 0, 0, 220, 198
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | 
    WS_SYSMENU
CAPTION "TrayMoon 1.10"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    ICON            904,ID_IMEJBULAN,10,8,20,20
    LTEXT           "Display moon phases in System Tray",IDC_STATIC,40,7,170,
                    10
    LTEXT           "Copyright \xA9 mypapit, 2004",IDC_STATIC,40,17,170,8
    LTEXT           "Info : mypapit@gmail.com",IDC_STATIC,40,27,170,8
    GROUPBOX        "Current Lunar & Hijri Status",IDC_STATIC,7,40,206,46
    CTEXT           "Hari bulan Melayu",IDC_HIJRAH,13,51,194,10
    CTEXT           "Keadaan bulan",IDC_BULAN,13,62,194,10
    CTEXT           "Tiada peristiwa hari ini",IDC_EVENT_INFO,13,73,194,10
    GROUPBOX        "Options",IDC_STATIC,7,90,206,82
    CONTROL         "Start with Windows",IDC_STARTUP,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,102,180,10
    CONTROL         "Use Malay Hijri Dates",IDC_MALAY,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,114,180,10
    CONTROL         "Remind important Hijri dates",IDC_REMINDER,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,126,180,10
    LTEXT           "Rotate Lunar Image:",IDC_STATIC,16,141,72,10
    COMBOBOX        IDC_ROTATE,92,139,112,60,CBS_DROPDOWNLIST | WS_VSCROLL | 
                    WS_TABSTOP
    LTEXT           "Lunar Graphics:",IDC_STATIC,16,156,72,10
    COMBOBOX        IDC_STYLE,92,154,112,60,CBS_DROPDOWNLIST | WS_VSCROLL | 
                    WS_TABSTOP
    DEFPUSHBUTTON   "OK",IDOK,50,177,55,14
